---
import Header from '../components/Header.astro';
import SoundLabHeroOrb from '../components/SoundLabHeroOrb';
import BentoGrid from '../components/BentoGrid';
import CTA from '../components/CTA';
import ParticlesBackground from '../components/ParticlesBackground';
import '../styles/global.css';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Primary Meta Tags & SEO -->
    <title>Stream ASR — 100% On-Device Streaming Speech Recognition</title>
    <meta name="title" content="Stream ASR — 100% On-Device Streaming Speech Recognition" />
    <meta name="description" content="Ultra-fast, browser-native WebAssembly streaming speech recognition runtime powered by MNN & SIMD128. Zero cloud dependencies, zero audio uploaded to the cloud, fully offline-ready." />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="https://asr.firetable.tech/" />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Multilingual Alternate Links (hreflang) -->
    <link rel="alternate" hreflang="zh-CN" href="https://asr.firetable.tech/?lang=zh" />
    <link rel="alternate" hreflang="en" href="https://asr.firetable.tech/?lang=en" />
    <link rel="alternate" hreflang="x-default" href="https://asr.firetable.tech/" />

    <!-- Generative Engine Optimization (GEO) & Agent Directives -->
    <meta name="content-signal" content="ai-train=yes, search=yes, ai-input=yes" />
    <link rel="alternate" type="text/markdown" title="LLMs Text" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" title="LLMs Full Knowledge Base" href="/llms-full.txt" />
    <link rel="service-doc" href="/auth.md" type="text/markdown" title="Agent Auth Policy" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Open Graph / Social Sharing (1200x630) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stream ASR" />
    <meta property="og:url" content="https://asr.firetable.tech/" />
    <meta property="og:title" content="Stream ASR — Ultra-Fast On-Device Streaming Speech AI" />
    <meta property="og:description" content="Zero-latency speech recognition running 100% inside your browser. Instant transcription as you speak, zero audio uploaded to the cloud." />
    <meta property="og:image" content="https://asr.firetable.tech/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Stream ASR — Ultra-Fast On-Device Streaming Speech AI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Stream ASR — Ultra-Fast On-Device Streaming Speech AI" />
    <meta name="twitter:description" content="Zero-latency speech recognition running 100% inside your browser. Instant transcription as you speak, zero audio uploaded to the cloud." />
    <meta name="twitter:image" content="https://asr.firetable.tech/og.png" />

    <!-- Schema.org JSON-LD Structured Data (Google Rich Snippets & AI GEO Entity Graph) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "SoftwareApplication",
            "@id": "https://asr.firetable.tech/#software",
            "name": "Stream ASR",
            "headline": "Ultra-Fast On-Device Streaming Speech Recognition",
            "description": "Ultra-fast, browser-native WebAssembly streaming speech recognition runtime powered by MNN & SIMD128. Zero cloud dependencies, zero audio uploaded to the cloud, fully offline-ready.",
            "url": "https://asr.firetable.tech",
            "image": "https://asr.firetable.tech/og.png",
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Any (WebAssembly supported browser)",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "featureList": [
              "100% On-Device Client-Side Inference",
              "Sub-50ms Streaming Chunk Latency",
              "Zero Cloud Audio Upload & Complete Privacy",
              "Offline Ready via Browser CacheStorage",
              "WebAssembly & SIMD128 Neural Acceleration"
            ],
            "softwareRequirements": "WebAssembly, SIMD128, AudioWorklet",
            "author": {
              "@type": "Organization",
              "name": "FireTable",
              "url": "https://firetable.tech"
            }
          },
          {
            "@type": "WebSite",
            "@id": "https://asr.firetable.tech/#website",
            "url": "https://asr.firetable.tech",
            "name": "Stream ASR",
            "description": "Ultra-Fast On-Device Streaming Speech Recognition Engine",
            "inLanguage": ["zh-CN", "en"],
            "publisher": {
              "@type": "Organization",
              "name": "FireTable",
              "url": "https://firetable.tech"
            }
          }
        ]
      }
    </script>

    <!-- Immediate Theme & i18n Initializer (Executes synchronously before page render to eliminate FOUC) -->
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('theme');
          var isDark = t !== null ? t === 'dark' : (window.matchMedia('(prefers-color-scheme: dark)').matches !== false);
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
          }

          var l = localStorage.getItem('stream_asr_lang');
          if (l === 'zh-cn' || l === 'en' || l === 'zh-hk') {
            document.documentElement.lang = l;
          } else if (l === 'zh') {
            document.documentElement.lang = 'zh-cn';
          } else if (l === 'yue' || l === 'zh-tw') {
            document.documentElement.lang = 'zh-hk';
          } else {
            var n = (navigator.language || '').toLowerCase();
            document.documentElement.lang = (n.startsWith('zh-hk') || n.startsWith('zh-mo') || n.startsWith('zh-tw') || n.startsWith('yue')) ? 'zh-hk' : (n.startsWith('zh') ? 'zh-cn' : 'en');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-sky-500/30 selection:text-sky-200 relative bg-zinc-50 dark:bg-[#08090a]">
    <!-- React Bits Particles: Deep Space Ambient Particle Field (Full-viewport interactive canvas) -->
    <ParticlesBackground client:load />

    <div class="relative z-10">
      <Header />

      <main class="w-full flex flex-col items-center">
        <!-- =========================================================
             MONUMENTAL HERO SECTION
             Text + Big Ball + Immersive Movie-Subtitle Streaming (No Card Box)
             ========================================================= -->
        <section id="hero" class="w-full min-h-[100dvh] flex flex-col items-center justify-start sm:justify-center text-center px-4 sm:px-6 lg:px-8 pt-16 sm:pt-18 md:pt-20 pb-8 relative overflow-x-clip">
          {/* Ambient Hero Spotlight & Mesh with Smooth Vertical Feathering (Eliminates Hard Bottom Cutoffs) */}
          <div 
            aria-hidden="true" 
            class="absolute inset-0 pointer-events-none overflow-hidden [mask-image:linear-gradient(to_bottom,black_45%,transparent_96%)] [-webkit-mask-image:linear-gradient(to_bottom,black_45%,transparent_96%)]"
          >
            <div class="absolute inset-0 linear-mesh" />
            <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[480px] bg-sky-400/12 dark:bg-sky-400/15 rounded-full blur-[140px] pointer-events-none" />
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[540px] h-[540px] bg-sky-500/10 dark:bg-sky-400/10 rounded-full blur-[120px] pointer-events-none" />
          </div>

          <!-- Monumental Headline: Majestic & Clean (No Gimmick Badges) with BlurText Reveal -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 max-w-5xl leading-[1.2] sm:leading-[1.16] mb-3 sm:mb-6 px-2 mt-2 sm:mt-0 animate-blur-reveal">
            <span class="inline-block" data-i18n="hero.titlePre">极速纯端侧</span> <br class="hidden sm:inline" />
            <span class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-cyan-500 to-sky-500 dark:from-sky-400 dark:via-cyan-300 dark:to-sky-200 px-1 pb-2 pt-0.5 -mb-2 [box-decoration-break:clone] [-webkit-box-decoration-break:clone]" data-i18n="hero.titleSpan">
              流式语音识别引擎
            </span>
          </h1>

          <!-- Subtitle -->
          <p data-i18n="hero.subtitle" class="text-xs sm:text-sm md:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed mx-auto mb-2 sm:mb-3 text-balance px-4 animate-blur-reveal-delay">
            在浏览器内直接运行的纯端侧流式语音识别。支持中文与英文，说话实时上屏，音频绝不上云，断网也能秒级转写。
          </p>

          <!-- THE BIG HERO BALL + IMMERSIVE MOVIE-SUBTITLE STREAMING -->
          <div class="w-full mt-1 sm:mt-2 flex flex-col items-center justify-center">
            <SoundLabHeroOrb client:load />
          </div>
        </section>

        <!-- =========================================================
             SECTION 1: APPLE BENTO GRID (SINGLE SCREEN OVERVIEW)
             ========================================================= -->
        <BentoGrid client:load />

        <!-- =========================================================
             SECTION 2: FINAL CALL TO ACTION (CTA)
             ========================================================= -->
        <CTA client:load />

        <!-- Pure CSS Sticky Console Dock: Bounded by <main>, strictly stays above <footer> with 0 latency -->
        <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pointer-events-none sticky bottom-5 mb-5 z-50 flex justify-end">
          <div id="console-sticky-dock" class="pointer-events-none"></div>
        </div>
      </main>

      <!-- =========================================================
           MINIMAL LINEAR/APPLE-STYLE FOOTER
           ========================================================= -->
      <footer id="site-footer" class="border-t border-zinc-200/80 dark:border-white/[0.06] py-8 text-xs text-zinc-500 dark:text-zinc-400">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
          <div class="flex items-center gap-2">
            <span class="font-medium text-zinc-800 dark:text-zinc-200">Stream ASR</span>
            <span class="text-zinc-300 dark:text-zinc-700">·</span>
            <span>© <span id="footer-year">{currentYear}</span> FireTable</span>
            <span class="text-zinc-300 dark:text-zinc-700">·</span>
            <span data-i18n="footer.license">Apache 2.0 开源协议</span>
          </div>

          <div class="flex items-center gap-6 text-zinc-500 dark:text-zinc-400 font-medium">
            <a href="https://github.com/FireTable/stream-asr" target="_blank" rel="noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition-colors">GitHub</a>
            <a href="https://github.com/FireTable/stream-asr#readme" target="_blank" rel="noreferrer" data-i18n="footer.docs" class="hover:text-zinc-900 dark:hover:text-white transition-colors">文档</a>
            <a href="#hero" data-i18n="footer.top" class="hover:text-zinc-900 dark:hover:text-white transition-colors">回到顶部</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- Lenis Damped Smooth Scrolling & i18n synchronization script -->
    <script>
      import Lenis from 'lenis';
      import { translations, getInitialLang, type Lang } from '../i18n/translations';

      // 1. Initialize Lenis momentum damped smooth scrolling (Linear-style)
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.0,
        touchMultiplier: 1.5,
      });
      (window as any).lenis = lenis;

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Smooth scroll anchor navigation
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (href && href.startsWith('#') && href.length > 1) {
            e.preventDefault();
            const targetEl = document.querySelector(href);
            if (targetEl) {
              lenis.scrollTo(targetEl, { offset: -70, duration: 1.2 });
            }
          }
        });
      });

      // 2. Client-side i18n synchronization
      function applyLang(lang: Lang) {
        const dict = (translations[lang] || translations['zh-cn']) as any;
        document.documentElement.lang = lang;
        if (dict.meta?.title) document.title = dict.meta.title;
        const metaDesc = document.querySelector('meta[name="description"]');
        if (metaDesc && dict.meta?.desc) metaDesc.setAttribute('content', dict.meta.desc);
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const parts = key.split('.');
          let val: any = dict;
          for (const p of parts) {
            val = val?.[p];
          }
          if (typeof val === 'string') {
            el.innerText = val;
          }
        });
      }

      // Initial apply with single source of truth
      applyLang(getInitialLang());

      // Listen for language change events
      window.addEventListener('stream_asr_lang_change', (e: Event) => {
        const customEvent = e as CustomEvent<Lang>;
        if (customEvent.detail) {
          applyLang(customEvent.detail);
        }
      });

      // 3. Dynamic client year calculation (never hardcoded)
      const yearEl = document.getElementById('footer-year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </body>
</html>
