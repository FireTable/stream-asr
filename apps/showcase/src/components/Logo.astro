---
interface Props {
  className?: string;
  size?: number;
}
const { className = "w-6 h-6 shrink-0", size = 26 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
>
  <defs>
    <!-- Dark Mode Foreground Ribbon: Sky Cyan -> Pure White Crest -> Azure -->
    <linearGradient id="mobius-grad-dark" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="45%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- Light Mode Foreground Ribbon: Deep Azure -> Vivid Sky Cyan -> Sapphire -->
    <linearGradient id="mobius-grad-light" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="45%" stop-color="#0ea5e9" />
      <stop offset="100%" stop-color="#0369a1" />
    </linearGradient>
  </defs>

  <!-- Dark Mode Mobius S-Stream -->
  <g class="hidden dark:inline">
    <!-- Underfold Depth Layer (Back) -->
    <path
      d="M25 11 C28 15 27 21 22 24 C17 27 11 24 10 19 C9 14 3 12 3 16"
      stroke="#0284c7"
      stroke-width="3.6"
      stroke-linecap="round"
      opacity="0.65"
    />
    <!-- Luminous Crest Ribbon (Front) -->
    <path
      d="M7 21 C4 17 5 11 10 8 C15 5 21 8 22 13 C23 18 29 20 29 16"
      stroke="url(#mobius-grad-dark)"
      stroke-width="3.6"
      stroke-linecap="round"
    />
  </g>

  <!-- Light Mode Mobius S-Stream -->
  <g class="inline dark:hidden">
    <!-- Underfold Depth Layer (Back) -->
    <path
      d="M25 11 C28 15 27 21 22 24 C17 27 11 24 10 19 C9 14 3 12 3 16"
      stroke="#0284c7"
      stroke-width="3.6"
      stroke-linecap="round"
      opacity="0.5"
    />
    <!-- Rich Contrast Ribbon (Front) -->
    <path
      d="M7 21 C4 17 5 11 10 8 C15 5 21 8 22 13 C23 18 29 20 29 16"
      stroke="url(#mobius-grad-light)"
      stroke-width="3.6"
      stroke-linecap="round"
    />
  </g>
</svg>
