---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle';
import LangDropdown from './LangDropdown';
---

<header class="fixed top-0 left-0 right-0 z-50 w-full border-b border-zinc-200/40 dark:border-white/[0.04] bg-white/20 dark:bg-[#08090a]/20 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 sm:h-14 md:h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 sm:gap-2.5 group shrink-0" aria-label="Stream ASR Home">
      <Logo className="w-[22px] h-[22px] sm:w-[26px] sm:h-[26px] shrink-0 group-hover:scale-105 transition-transform duration-200" />
      <span class="font-semibold text-sm sm:text-base tracking-tight text-zinc-900 dark:text-white whitespace-nowrap">
        Stream ASR
      </span>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center gap-7 text-xs sm:text-sm font-normal text-zinc-600 dark:text-zinc-400">
      <a href="#hero" data-i18n="nav.playground" class="hover:text-zinc-900 dark:hover:text-white transition-colors">演练场</a>
      <a href="#features" data-i18n="nav.benchmarks" class="hover:text-zinc-900 dark:hover:text-white transition-colors">特性与基准</a>
      <a href="#cta" data-i18n="nav.getStarted" class="hover:text-zinc-900 dark:hover:text-white transition-colors">快速开始</a>
    </nav>

    <!-- Actions (Language Menu, Theme, GitHub) - Pure Minimalist Icons -->
    <div class="flex items-center gap-0.5 sm:gap-1.5 shrink-0">
      <LangDropdown client:load />
      <ThemeToggle client:load />

      <a
        href="https://github.com/FireTable/stream-asr"
        target="_blank"
        rel="noreferrer"
        class="p-1.5 sm:p-2 rounded-full text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-white/[0.05] transition-colors focus:outline-none flex items-center justify-center shrink-0"
        title="GitHub"
        aria-label="GitHub Repository"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current text-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
    </div>
  </div>
</header>
